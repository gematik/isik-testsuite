{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchPackageNames": ["de.gematik.test:tiger-maven-plugin", "de.gematik.test:tiger-test-lib" ,"de.gematik:tiger-cloud-extension"],
      "allowedVersions": "/^[0-9]+\\.[0-9]+\\.[0-9]+$/"
    },
    {
      "matchManagers": ["maven"],
      "groupName": "maven dependencies"
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": "docker"
    }
  ]
}
