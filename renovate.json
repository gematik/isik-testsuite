{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchManagers": ["maven"],
      "groupName": "maven dependencies"
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": "docker"
    }
  ]
}
